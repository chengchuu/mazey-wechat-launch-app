{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "lib",
    "importHelpers": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "typing.d.ts"],
  "exclude": [
    ".pages-api",
    "coverage",
    "dist",
    "dist-dev",
    "docs",
    "lib",
    "node_modules",
    "site"
  ],
  "typedocOptions": {
    "entryPoints": ["./src/index.ts"],
    "hostedBaseUrl": "https://chengchuu.github.io/mazey-wechat-launch-app/api/",
    "highlightLanguages": ["bash", "html", "javascript", "typescript"]
  }
}
