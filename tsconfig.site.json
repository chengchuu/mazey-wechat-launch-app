{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": [],
    "declaration": false,
    "declarationMap": false,
    "importHelpers": false,
    "rootDir": ".",
    "outDir": "dist-dev"
  },
  "include": ["examples/**/*.ts", "site/**/*.ts", "src/**/*.ts", "typing.d.ts"],
  "exclude": [".pages-api", "dist", "dist-dev", "docs", "lib", "node_modules"]
}
